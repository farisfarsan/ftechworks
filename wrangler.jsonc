{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ftechworks",
  "compatibility_date": "2026-08-09",
  // Static-assets-only Worker: serves the Next.js static export from
  // ./out directly, with no server code and no framework adapter.
  // Because this file already exists, `wrangler deploy` uses it as-is
  // instead of running its "detect framework, migrate to OpenNext"
  // flow — which is what was failing (that adapter requires Next 15+,
  // and this site has no server-rendered routes to justify it anyway).
  "assets": {
    "directory": "./out",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
